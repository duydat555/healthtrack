# Sao chép thành .env: cp .env.example .env
ENV=development
JWT_SECRET=doi-thanh-chuoi-bi-mat-dai-ngau-nhien
CORS_ORIGINS=http://localhost:8080
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
SLOW_REQUEST_MS=500

# AI Coach (Claude). Để trống thì /coach trả 503
# Tùy chọn: chỉ cần khi muốn dùng Claude. Chỉ dùng AI local thì để trống.
ANTHROPIC_API_KEY=
# AI local trên Mac (make llm). Trong Docker: http://host.docker.internal:8090/v1
LOCAL_LLM_URL=

# Cổng trên máy bạn (đổi nếu bị trùng với dự án khác)
BACKEND_PORT=8000
DB_PORT=5432
ADMINER_PORT=8080
